rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true if the request comes from an authenticated user.
    function isSignedIn() {
      return request.auth != null;
    }

    // Returns true if the authenticated user is accessing their own data.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Returns true if the authenticated user has an 'admin' role in their user document.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for user profiles: users/{userId}
    match /users/{userId} {
      // Members can read their own profile; Admins can read all user profiles.
      allow read: if isOwner(userId) || isAdmin();

      // On signup, a user can only create their profile with role = 'member' (never admin).
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'member';

      // A user can update their profile, but cannot change their own role.
      // Admins cannot change other users' roles from the client app.
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role;

      // Deleting user documents from the client app is disallowed.
      allow delete: if false;

      // Daily reading entries: users/{userId}/readings/{date}
      match /readings/{date} {
        // Members can read and write their own daily readings; Admins can read all readings.
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
    }

    // Default deny all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
