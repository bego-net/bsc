rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Returns true if the request comes from an authenticated user.
    function isSignedIn() {
      return request.auth != null;
    }

    // Returns true if the authenticated user is accessing their own data.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Returns true if the authenticated user has an 'admin' role in their user document.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for user profiles: users/{userId}
    match /users/{userId} {
      // Signed-in users can read profiles for community stats/leaderboard; Admins can read all.
      allow read: if isSignedIn();

      // On signup, a user can only create their profile with role = 'member' (never admin).
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'member';

      // A user can update their profile, but cannot change their own role.
      // Admins cannot change other users' roles from the client app.
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role;

      // Deleting user documents from the client app is disallowed.
      allow delete: if false;

      // Daily reading entries: users/{userId}/readings/{date}
      match /readings/{date} {
        // Signed-in users can read reading status for leaderboard & community progress
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      // Old Testament reading entries: users/{userId}/otReadings/{date}
      match /otReadings/{date} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // Config: config/currentWeek, config/currentOtWeek
    match /config/{configDoc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Team BS Weeks: weeks/{weekId}
    match /weeks/{weekId} {
      // Signed-in users can read week info; only admins can write
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Discussion Questions: weeks/{weekId}/questions/{id}
      match /questions/{id} {
        allow read: if isAdmin() || (isSignedIn() && resource.data.published == true);
        allow write: if isAdmin();
      }

      // Study Materials: weeks/{weekId}/materials/{id}
      match /materials/{id} {
        allow read: if isAdmin() || (isSignedIn() && resource.data.published == true);
        allow write: if isAdmin();
      }

      // Member Preparation Status: weeks/{weekId}/prepared/{uid}
      match /prepared/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }
    }

    // Old Testament Weeks: otWeeks/{weekId}
    match /otWeeks/{weekId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Assigned Days: otWeeks/{weekId}/days/{date}
      match /days/{date} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // Default deny all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
